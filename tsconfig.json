{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // Fixture files are run directly by node --experimental-strip-types, which
    // does not do extensionless resolution. See lib/*-fixtures.ts.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "lib/detect-stack-fixtures.ts",
    "lib/net-guard-fixtures.ts",
    "lib/sitemap-fixtures.ts",
    "lib/store-fixtures.ts",
    "lib/razorpay-fixtures.ts",
    "lib/entitlement-fixtures.ts",
    "lib/effort-fixtures.ts"
  ]
}
