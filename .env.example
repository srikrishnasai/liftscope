# Required in production. Dev falls back to a local secret.
AUTH_SECRET=

# Durable store (Upstash Redis). Set BOTH to make reports, accounts, and paid
# unlocks survive cold starts and multiple serverless instances. Required in
# production — without them the app falls back to a local JSON file, which on
# Vercel lives under /tmp and is lost on every recycle.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Razorpay (payments). Without the key pair, unlock stays free for local review.
# Test keys start rzp_test_, live keys rzp_live_.
# Dashboard: https://dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# A SEPARATE secret, chosen when you create the webhook in the Razorpay
# dashboard. It is not the key secret, and the two are not interchangeable:
# the key secret signs payment callbacks, this one signs webhook bodies.
RAZORPAY_WEBHOOK_SECRET=

# Price in paise (the smallest INR unit). 149900 = ₹1,499, which is the
# default. Quote it to buyers as "+ GST" — a GST-registered business claims
# input credit, so the tax is a wash for them.
RAZORPAY_UNIT_AMOUNT=149900
RAZORPAY_CURRENCY=INR

# Optional AI polish for the client memo (never used for scoring).
# Hugging Face Inference Providers (preferred for this project):
#   HF_TOKEN=hf_...
#   HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# Or OpenAI-compatible:
#   OPENAI_API_KEY=
#   OPENAI_MODEL=gpt-4o-mini
#   OPENAI_BASE_URL=https://api.openai.com/v1
# A token starting with hf_ without OPENAI_BASE_URL also uses Hugging Face.

# Local testing only: disables the outbound SSRF host guard so private
# addresses and localhost can be fetched. Never set this in production.
# LIFTSCOPE_ALLOW_PRIVATE_HOSTS=1
