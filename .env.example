# Required in production. Dev falls back to a local secret.
AUTH_SECRET=

# Optional. Stripe Checkout for unlocking the full report.
# Without STRIPE_SECRET_KEY, the report still unlocks locally for review.
# Test mode: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. If unset, Checkout uses an inline $49 USD price.
STRIPE_PRICE_ID=
STRIPE_UNIT_AMOUNT=4900
STRIPE_CURRENCY=usd

# Optional AI polish for the client memo (never used for scoring).
# Hugging Face Inference Providers (preferred for this project):
#   HF_TOKEN=hf_...
#   HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# Or OpenAI-compatible:
#   OPENAI_API_KEY=
#   OPENAI_MODEL=gpt-4o-mini
#   OPENAI_BASE_URL=https://api.openai.com/v1
# A token starting with hf_ without OPENAI_BASE_URL also uses Hugging Face.

# Local testing only: disables the outbound SSRF host guard so private
# addresses and localhost can be fetched. Never set this in production.
# LIFTSCOPE_ALLOW_PRIVATE_HOSTS=1

# Durable store (Upstash Redis). Set BOTH to make reports, accounts, and paid
# unlocks survive cold starts and multiple serverless instances. Required in
# production — without them the app falls back to a local JSON file, which on
# Vercel lives under /tmp and is lost on every recycle.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
